  const gear=(x,y,n,id,col)=>`<g class="gr" id="${id}" style="transform-origin:${x}px ${y}px;transform-box:view-box"><path d="${gearPath(x,y,R(n),n)}" fill="${col}" stroke="#1b2226" stroke-width="2"/><circle cx="${x}" cy="${y}" r="${Math.max(6,R(n)*.18)}" fill="#1b2226"/></g>`;
  el.querySelector('#crGears').innerHTML=`<text x="${x1}" y="330" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9aa29f">motor</text>${gear(x1,410,t[0],'cg0','#c9cfcc')}${gear(x2,410,t[1],'cg1','#9aa29f')}${gear(x3,410,t[2],'cg2','#c9a23a')}${gear(x4,410,t[3],'cg3','#8a7a40')}<text x="${Math.min(x4,880)}" y="330" text-anchor="middle" font-family="${MONO}" font-size="14" fill="#9aa29f">drum</text>`;
  const k=S.fulc, xf=510+k*.025*400; el.querySelector('#crFul').setAttribute('d',`M${xf} 712 l-14 26 h28z`); el.querySelector('#crFt').textContent=`pivot ${(k*.025).toFixed(3)} m from the band pin`;
  if(S.f.crane){ el.querySelector('#crCask').style.transform='translateY(-330px)'; el.querySelector('#crCable').setAttribute('y2',230); }
},
spin(el,i,rpm){ const t=S.gear.map(x=>TEETH[x]); const sp=[rpm,rpm*t[0]/t[1],rpm*t[0]/t[1],rpm*t[0]/t[1]*t[2]/t[3]]; [0,1,2,3].forEach(j=>{ const g=el.querySelector('#cg'+j); g.getAnimations().forEach(a=>a.cancel()); if(rpm>0) g.animate([{transform:'rotate(0)'},{transform:`rotate(${j%2?-360:360}deg)`}],{duration:Math.min(20000,Math.max(120,60000/sp[j]*6)),iterations:Infinity}); }); },
act(a,h,el){
  if(a.startsWith('plate-')) return openPlate(a.slice(6));
  if(!bayPowered()){ say('The crane needs the bay\'s power. Bring the reactor online first.'); sfx.buzz(); return; }
  if(a.startsWith('gm-')||a.startsWith('gp-')){ if(S.f.crane) return; const i=+a.slice(3); S.gear[i]=(S.gear[i]+(a[1]==='p'?1:TEETH.length-1))%TEETH.length; sfx.click(); refresh(); return; }
  if(a.startsWith('fmove-')){ if(S.f.brake) return; S.fulc=Math.max(1,Math.min(20,S.fulc+parseInt(a.slice(6)))); sfx.click(); refresh(); return; }
  if(a.startsWith('fh-')){ if(S.f.brake) return; S.fulc=+a.slice(3); sfx.click(); refresh(); return; }
  if(a==='hoist'){
    if(S.f.crane){ say('The cask is up and locked on the gantry.'); return; } if(this._run) return; const p=P();
    const i=this.ratio(), Tout=p.Tm*i*.81, Tload=p.M*GM*p.rd, v=1450/i*2*Math.PI*p.rd/60; this._run=true; sfx.clunk(); this.spin(el,0,Tout>=Tload?1450:60);
    setTimeout(()=>{ this._run=false;
      if(Tout<Tload){ this.spin(el,0,0); sfx.buzz(); el.querySelector('#crSmoke').innerHTML=Array.from({length:10},()=>`<circle cx="${rnd(80,200)}" cy="400" r="${rnd(10,24)}" fill="#9aa29f" opacity=".5"><animate attributeName="cy" by="-160" dur="2s" fill="freeze"/><animate attributeName="opacity" from=".5" to="0" dur="2s" fill="freeze"/></circle>`).join(''); S.mistakes++; say(`<b>Motor stall.</b> The drum gets ${Tout.toFixed(0)} N·m after losses but the cask needs ${Tload.toFixed(0)} N·m. Ratio ${i.toFixed(2)} is too low.`,5400); save(); return; }
      if(v<p.vmin){ el.querySelector('#crCask').animate([{transform:'translateY(0)'},{transform:'translateY(-30px)'},{transform:'translateY(0)'}],{duration:3000}); setTimeout(()=>this.spin(el,0,0),2800); S.mistakes++; say(`It lifts, but at ${v.toFixed(3)} m/s. HALE: <i>"Too slow. At that speed we miss the pass window. I need at least ${p.vmin.toFixed(2)} m/s."</i>`,5600); save(); return; }
      const ck=el.querySelector('#crCask'); ck.style.transition='transform 3s ease-in-out'; ck.style.transform='translateY(-330px)'; el.querySelector('#crCable').setAttribute('y2',230); setTimeout(()=>this.spin(el,0,0),3000);
      S.f.crane=true; sfx.success(); note(`Hoisted the cask: ratio ${i.toFixed(2)} gives ${Tout.toFixed(0)} N·m (need ${Tload.toFixed(0)}) at ${v.toFixed(3)} m/s.`); say(`The cask rises smoothly at ${v.toFixed(2)} m/s. Now set the holding brake.`,4600); save(); checkDone();
    },1400);
  }
  if(a==='brake'){
    if(S.f.brake){ say('The brake is set.'); return; } const p=P(); const ag=S.fulc*.025, ma=(1-ag)/ag, F=150*ma, travel=20*ma;
    if(F<p.Fb){ sfx.buzz(); S.mistakes++; say(`You haul on the lever with everything you have: ${F.toFixed(0)} N at the pin. The band needs ${fk(p.Fb)} N. It slips.`,5000); save(); return; }
    if(travel>280){ sfx.buzz(); S.mistakes++; say(`Plenty of force, but the band needs 20 mm of pin travel, which means ${travel.toFixed(0)} mm at your hand. Your arm runs out at 280 mm.`,5400); save(); return; }
    S.f.brake=true; sfx.clunk(); sfx.success(); note(`Set the holding brake: pivot ${ag.toFixed(3)} m from the pin, mechanical advantage ${ma.toFixed(2)}.`); say(`The band bites. ${F.toFixed(0)} N at the pin, ${travel.toFixed(0)} mm of hand travel. The cask is held.`,4800); save(); checkDone();
  }
}};
