    S.f.bat=true; sfx.tubeon(); sfx.success(); note(`Built a ${S.bs}S${S.bp}P battery: ${V.toFixed(1)} V, ${S.bp*p.C} Ah. HALE booted.`); say(`Lights come up. HALE: <i>"Runtime ${run.toFixed(1)} hours. Thank you. I was beginning to worry."</i>`,5200); refresh();
  }
}};

