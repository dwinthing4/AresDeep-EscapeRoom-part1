<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ares Deep</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;600;700&amp;family=Barlow:ital,wght@0,400;0,600;1,400&amp;family=JetBrains+Mono:wght@400;700&amp;family=Courier+Prime:wght@400;700&amp;display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --surround:#c8c2b8;
  --surround-ink:#1e2428;
  --hull:#151b1e;
  --hull-2:#1f272b;
  --brass:#3fbfb0;
  --brass-hi:#7fe8dc;
  --brass-lo:#2a5a55;
  --amber:#f2c230;
  --paper:#e8ece9;
  --paper-ink:#1b2226;
  --verdigris:#e0905a;
  --alarm:#c0503a;
  --serif:"Barlow", "Segoe UI", system-ui, sans-serif;
  --sc:"Chakra Petch", "Barlow", sans-serif;
  --tape:"Courier Prime", "Courier New", Courier, monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){ --surround:#08090a; --surround-ink:#c9cfcc; }
}
:root[data-theme="dark"]{ --surround:#08090a; --surround-ink:#c9cfcc; }
html{ height:100%; scroll-padding-top:env(safe-area-inset-top,0px); }
*,*::before,*::after{ box-sizing:inherit; }
body{ margin:0; height:100%; background:var(--surround); color:var(--surround-ink); font-family:var(--serif); overflow:hidden; -webkit-tap-highlight-color:transparent; }
button{ font-family:inherit; }
:focus-visible{ outline:2px solid var(--brass-hi); outline-offset:2px; }

#app{ height:100%; display:flex; flex-direction:column; }

/* ---------- HUD ---------- */
#hud{ flex:0 0 auto; display:flex; align-items:center; gap:.6rem; padding:.45rem .8rem; background:linear-gradient(#1f272b,#12171a); border-bottom:2px solid var(--brass-lo); color:var(--paper); }
#hud h1{ margin:0; font-family:var(--sc); font-weight:400; font-size:1.15rem; letter-spacing:.04em; color:var(--brass-hi); white-space:nowrap; }
#hud .spacer{ flex:1; }
#timer{ font-family:var(--tape); font-weight:700; font-size:1rem; color:var(--amber); min-width:4.5em; text-align:right; }
.hbtn{ background:linear-gradient(#3a4a55,#25323c); color:var(--paper); border:1px solid var(--brass-lo); border-radius:3px; padding:.3rem .7rem; font-size:.95rem; cursor:pointer; }
.hbtn:hover{ border-color:var(--brass-hi); color:#fff; }
.hbtn .n{ font-family:var(--tape); color:var(--amber); font-size:.8rem; }

/* ---------- Stage ---------- */
#stage-wrap{ flex:1 1 auto; min-height:0; display:flex; align-items:center; justify-content:center; padding:.4rem; }
#stage{ position:relative; aspect-ratio:16/9; width:min(100%, calc((100dvh - 9.5rem - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)) * 16 / 9)); max-height:100%; background:#05080b; overflow:hidden; border:2px solid var(--brass-lo); box-shadow:0 0 0 1px #000, 0 10px 40px rgba(0,0,0,.5); user-select:none; -webkit-user-select:none; touch-action:manipulation; }
.layer{ position:absolute; inset:0; will-change:transform,opacity; }
.layer svg{ width:100%; height:100%; display:block; }
.layer.hidden{ visibility:hidden; }
#grain{ position:absolute; inset:0; pointer-events:none; opacity:.09; mix-blend-mode:overlay; z-index:5; }
#vignette{ position:absolute; inset:0; pointer-events:none; z-index:6; background:radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,.55) 100%); }
#flash{ position:absolute; inset:0; pointer-events:none; z-index:7; background:#cfe3ff; opacity:0; mix-blend-mode:screen; }
#flash.on{ animation:lightning 1.1s ease-out; }
@keyframes lightning{ 0%{opacity:0} 4%{opacity:.35} 9%{opacity:.05} 14%{opacity:.28} 40%{opacity:0} 100%{opacity:0} }
#back{ position:absolute; left:1.2%; bottom:2%; z-index:8; display:none; background:rgba(14,20,26,.78); color:var(--paper); border:1px solid var(--brass); border-radius:20px; padding:.35rem .9rem .35rem .7rem; font-size:1rem; cursor:pointer; }
#back:hover{ background:rgba(40,52,62,.9); }
#caption{ position:absolute; left:50%; bottom:2.2%; transform:translateX(-50%); z-index:8; max-width:72%; text-align:center; pointer-events:none; color:#f3ead4; font-size:clamp(.8rem,1.5vw,1.1rem); font-style:italic; text-shadow:0 1px 3px #000, 0 0 12px #000; opacity:0; transition:opacity .25s; }
#caption.on{ opacity:1; }
#toast{ position:absolute; left:50%; top:3%; transform:translate(-50%,-10px); z-index:9; max-width:80%; background:rgba(12,18,23,.9); border:1px solid var(--brass); color:var(--paper); padding:.5rem 1rem; border-radius:3px; font-size:clamp(.82rem,1.5vw,1.05rem); line-height:1.4; opacity:0; transition:opacity .3s, transform .3s; pointer-events:none; text-align:center; }
#toast.on{ opacity:1; transform:translate(-50%,0); }

/* hotspots */
.hot{ cursor:pointer; }
.hot .hl{ fill:transparent; stroke:transparent; }
.hot:hover .hl, .hot:focus .hl{ stroke:rgba(230,201,127,.55); stroke-width:3; fill:rgba(230,201,127,.06); }
.hot:hover .glowme{ filter:url(#hoverGlow); }
.selmode .usable .hl{ stroke:rgba(242,181,82,.5); stroke-dasharray:8 6; stroke-width:2; animation:march 1s linear infinite; }
@keyframes march{ to{ stroke-dashoffset:-28; } }

/* generic SVG animation helpers */
.tr{ transition:transform .7s cubic-bezier(.3,.7,.2,1), opacity .5s; transform-box:fill-box; }
.drop{ animation:rain .55s linear infinite; }
@keyframes rain{ from{ transform:translate(0,-60px);} to{ transform:translate(-18px,140px);} }
.flicker{ animation:flick 2.2s infinite; transform-box:fill-box; transform-origin:50% 100%; }
@keyframes flick{ 0%,100%{transform:scale(1,1); opacity:1} 30%{transform:scale(.94,1.07); opacity:.92} 55%{transform:scale(1.04,.95)} 75%{transform:scale(.97,1.04); opacity:.96} }
.dust{ animation:dust 9s ease-in-out infinite; }
@keyframes dust{ 0%,100%{ transform:translate(0,0); opacity:.0 } 30%{opacity:.7} 50%{ transform:translate(14px,-20px); opacity:.5 } 80%{opacity:.6} }
.sway{ animation:sway 2s ease-in-out infinite alternate; transform-box:view-box; }
@keyframes sway{ from{ transform:rotate(-9deg);} to{ transform:rotate(9deg);} }
.spin{ animation:spin 4s linear infinite; transform-box:fill-box; transform-origin:center; }
.spin.rev{ animation-direction:reverse; }
.spin.fast{ animation-duration:1.6s; }
@keyframes spin{ to{ transform:rotate(360deg);} }
.sweep{ animation:sweep 6s linear infinite; transform-box:view-box; }
@keyframes sweep{ 0%{ opacity:0 } 15%{opacity:.9} 35%{opacity:0} 100%{opacity:0} }
.wave{ animation:wave 5s ease-in-out infinite alternate; }
@keyframes wave{ from{ transform:translateX(-30px);} to{ transform:translateX(30px);} }
.shake{ animation:shake .45s; transform-box:fill-box; }
@keyframes shake{ 0%,100%{transform:translateX(0)} 20%{transform:translateX(-9px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-6px)} 80%{transform:translateX(4px)} }
.pulse{ animation:pulse 1.6s ease-in-out infinite; }
@keyframes pulse{ 0%,100%{opacity:.35} 50%{opacity:1} }

/* ---------- Inventory ---------- */
#inv{ flex:0 0 auto; display:flex; align-items:center; gap:.5rem; padding:.45rem .8rem; background:linear-gradient(#12171a,#1f272b); border-top:2px solid var(--brass-lo); min-height:4.6rem; overflow-x:auto; }
#inv .lbl{ font-family:var(--sc); color:var(--brass); font-size:.95rem; margin-right:.3rem; white-space:nowrap; }
.slot{ flex:0 0 auto; width:3.6rem; height:3.6rem; border:1px solid #3d4b55; background:radial-gradient(#2a3843,#18232b); border-radius:4px; display:flex; align-items:center; justify-content:center; cursor:pointer; position:relative; padding:0; }
.slot svg{ width:82%; height:82%; }
.slot:hover{ border-color:var(--brass); }
.slot.sel{ border-color:var(--amber); box-shadow:0 0 0 2px rgba(242,181,82,.35), 0 0 14px rgba(242,181,82,.4); }
.slot.new{ animation:newitem 1.2s ease-out; }
@keyframes newitem{ 0%{ transform:scale(1.5); box-shadow:0 0 30px var(--amber);} 100%{ transform:scale(1);} }
.slot.empty{ cursor:default; opacity:.4; }
#invhelp{ color:#8d9aa3; font-size:.85rem; font-style:italic; margin-left:auto; white-space:nowrap; padding-left:.5rem; }

/* ---------- Modal ---------- */
#modal{ position:fixed; inset:0; z-index:50; display:none; align-items:center; justify-content:center; background:rgba(3,6,9,.72); backdrop-filter:blur(2px); padding:1rem; }
#modal.on{ display:flex; }
#mbox{ position:relative; max-width:min(1000px,96vw); max-height:92dvh; overflow:auto; background:var(--hull); border:2px solid var(--brass-lo); color:var(--paper); padding:1.3rem 1.5rem 1.2rem; border-radius:3px; box-shadow:0 20px 60px rgba(0,0,0,.6); animation:mopen .35s cubic-bezier(.2,.8,.2,1); }
@keyframes mopen{ from{ transform:scale(.92) translateY(14px); opacity:0;} }
#mbox h2{ margin:0 0 .6rem; font-family:var(--sc); font-weight:400; color:var(--brass-hi); font-size:1.45rem; }
#mclose{ position:absolute; right:.6rem; top:.5rem; background:none; border:none; color:var(--paper); font-size:1.6rem; cursor:pointer; line-height:1; }
.mtext{ line-height:1.55; font-size:1.05rem; max-width:62ch; }
.paper{ background:linear-gradient(135deg,#efe3c6,#ddcba4); color:var(--paper-ink); padding:1.4rem 1.6rem; border-radius:2px; box-shadow:inset 0 0 40px rgba(110,80,30,.35); }
.mbtns{ display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.9rem; }
.mbtn{ background:linear-gradient(#5ad6c8,#2a9a8e); color:#0b1a18; border:1px solid #1d5a54; border-radius:3px; padding:.4rem 1rem; font-size:1rem; cursor:pointer; font-family:var(--serif); }
.mbtn:hover{ filter:brightness(1.12); }
.mbtn.ghost{ background:transparent; color:var(--paper); border-color:var(--brass-lo); }
.mbtn:disabled{ opacity:.45; cursor:default; filter:none; }

/* log book */
.book{ display:flex; gap:0; perspective:1600px; }
.page{ flex:1; min-height:24rem; width:min(36rem,86vw); padding:1.6rem 1.8rem; background:linear-gradient(90deg,#d9c79f,#ecdfc2 8%,#efe4c9); color:var(--paper-ink); font-size:1.08rem; line-height:1.6; box-shadow:inset 0 0 50px rgba(120,85,30,.35); border-radius:2px; position:relative; transform-origin:left center; }
.page.turn{ animation:turn .6s ease-in-out; }
@keyframes turn{ 0%{ transform:rotateY(0)} 50%{ transform:rotateY(-80deg); filter:brightness(.7)} 100%{ transform:rotateY(0)} }
.page h3{ font-family:var(--sc); font-weight:400; margin:0 0 .5rem; font-size:1.2rem; }
.page .pno{ position:absolute; bottom:.6rem; right:1rem; font-style:italic; opacity:.6; font-size:.9rem; }
.ph{ position:relative; }
.lit .ph::after{ content:""; position:absolute; left:50%; top:-.25em; width:5px; height:5px; margin-left:-2.5px; border-radius:50%; background:#fff6c8; box-shadow:0 0 6px 3px #ffd36b; }
.lit .ph{ color:#7a2a08; text-shadow:0 0 8px rgba(255,190,80,.9); }
.dimnote{ font-style:italic; color:#6b5634; font-size:.95rem; margin-top:.6rem; }

/* tables */
.ttab{ border-collapse:collapse; font-size:1rem; }
.ttab th,.ttab td{ border:1px solid #9a835a; padding:.3rem .55rem; text-align:center; }
.ttab th{ font-family:var(--sc); font-weight:400; background:rgba(150,110,50,.15); }
.morsegrid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(6.2rem,1fr)); gap:.25rem .9rem; font-size:1.05rem; }
.morsegrid span b{ display:inline-block; width:1.3em; font-family:var(--sc); }
.morsegrid span i{ font-family:var(--tape); font-style:normal; letter-spacing:.12em; }
.tapeview{ font-family:var(--tape); font-size:1.15rem; letter-spacing:.15em; background:#f4ecd6; color:#20160c; padding:.8rem 1rem; border-radius:2px; word-break:break-all; line-height:1.9; max-height:16rem; overflow:auto; }

/* journal / hints */
.jlist{ margin:0; padding-left:1.1rem; line-height:1.55; }
.jlist li{ margin-bottom:.35rem; }
.hint{ border-left:3px solid var(--brass-lo); padding:.3rem .8rem; margin:.5rem 0; background:rgba(255,255,255,.03); line-height:1.5; }
.goal{ color:var(--amber); font-style:italic; margin-bottom:.4rem; }

/* overlays */
.overlay{ position:fixed; inset:0; z-index:60; display:none; align-items:center; justify-content:center; padding:1.2rem; background:radial-gradient(ellipse at 50% 85%, #7a3214 0%, #2a120a 45%, #08090a 100%); color:var(--paper); }
.overlay.on{ display:flex; }
.ovin{ max-width:44rem; text-align:left; }
.ovin .t1{ font-family:var(--sc); font-size:clamp(2.4rem,7vw,4.6rem); line-height:.95; color:#ffd2a0; margin:0; letter-spacing:.01em; }
.ovin .t2{ font-style:italic; color:var(--verdigris); font-size:clamp(1rem,2.2vw,1.3rem); margin:.5rem 0 1.4rem; }
.ovin p{ line-height:1.65; font-size:clamp(1rem,1.9vw,1.15rem); max-width:60ch; }
.ovin .mbtns{ margin-top:1.6rem; }
#intro-beam{ position:absolute; inset:0; pointer-events:none; overflow:hidden; }
.stat{ display:inline-block; margin-right:2rem; }
.stat b{ display:block; font-family:var(--tape); font-size:1.6rem; color:var(--amber); font-weight:400; }

@media (max-width:640px){
  #hud h1{ font-size:.95rem; }
  .hbtn{ padding:.25rem .45rem; font-size:.85rem; }
  #invhelp{ display:none; }
  .slot{ width:3rem; height:3rem; }
}
@media (prefers-reduced-motion: reduce){
  .drop,.dust,.wave,.sway{ animation:none; }
}
</style>
