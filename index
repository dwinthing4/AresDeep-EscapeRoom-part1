function objective(){
  const f=S.f, p=P();
  if(!f.bat) return {k:'bat',g:'Build a battery pack to wake HALE.',h:[`Read the three plates in Power Bay B. The pack voltage has to match the load. Check the HALE manual (top bar) on series and parallel cells.`,`Series cells = ${p.V.toFixed(1)} ÷ 3.7. Then work out the energy HALE needs (W × h), divide by 80 % depth of discharge, then by the pack voltage for amp-hours. You'll need more cells than the tray holds: the drone and the EVA suit locker have some.`,`${p.ns} in series. Energy ${p.W} × ${p.T} = ${p.W*p.T} Wh ÷ 0.8 = ${(p.W*p.T/.8).toFixed(0)} Wh ÷ ${p.V.toFixed(1)} V = ${p.ah.toFixed(2)} Ah ÷ ${p.C} Ah per string = ${p.np} parallel strings. Set ${p.ns} series × ${p.np} parallel (${p.ns*p.np} cells).`]};
  if(!f.logic) return {k:'logic',g:'Rebuild the door interlock logic.',h:['Take the spec printout from the terminal tray. Fill in the K-map pad from its Y column, then group the 1s. The manual\'s Digital logic chapter explains.','The minimal form is Y = ¬D · (A·B + C). Build it from NANDs: NOT is a NAND with both inputs tied together; A·B + C is NAND(NAND(A,B), NOT C); an AND is a NAND followed by a NOT.','G1 = A,B. G2 = C,C. G3 = G1,G2. G4 = D,D. G5 = G3,G4. G6 = G5,G5. Wire Y to G6 and run the test.']};
  if(!f.door) return {k:'door',g:'Open the blast door hydraulically.',h:['The door plate gives you mass, friction and seal drag. Remember where you are: Mars gravity is 3.71 m/s².',`Breakaway force = μs × m × g + seal drag. Pick a cylinder, work out its area (π d² ÷ 4), and set pressure = force ÷ area. Stay under the cylinder rating, the 14 MPa pump limit and the ${fk(p.Fmax)} N track limit.`,`F = ${p.mu.toFixed(2)} × ${fk(p.m)} × 3.71 + ${fk(p.seal)} = ${fk(p.Freq)} N. For example the Ø${p.cylAns.d} mm cylinder at ${p.pAns.toFixed(1)} MPa gives ${fk(p.pAns*1e6*Math.PI*(p.cylAns.d/2000)**2)} N.`]};
  if(!f.reactor) return {k:'reactor',g:'Restart the reactor without overheating it.',h:['Read the reactor, coolant and pump plates, and the return-temperature gauge. The Heat transfer chapter has the formula.',`ṁ = Q ÷ (c × ΔT), where ΔT = ${p.Tmax} − ${p.Tc} = ${p.Tmax-p.Tc} K. Convert kg/s to L/min with the density, then to rpm with the displacement.`,`ṁ = ${p.Q} ÷ (${p.cp} × ${p.Tmax-p.Tc}) = ${p.mdot.toFixed(4)} kg/s → ${p.Lmin.toFixed(2)} L/min → ${p.rpmReq.toFixed(1)} rpm. Set at least ${Math.ceil(p.rpmReq)} rpm (and no more than ${Math.floor(p.rpmReq*1.3)}).`]};
  if(!f.electro) return {k:'electro',g:'Make oxygen for the ascent.',h:['You need two amounts of O₂: the cabin fill (ideal gas law, from the cabin plate) and the flight use (poster plus flight plan, with its reserve). The Chemistry chapter walks through it.',`Cabin: n = 21,000 × ${p.Vc.toFixed(1)} ÷ (8.314 × 293.15). Flight: 0.84 kg/day × ${p.H}/24 × 1.5, converted to moles with 31.998 g/mol. Water = 2 × total O₂ moles × 18.015 g.`,`Cabin ${p.n_fill.toFixed(2)} mol + flight ${p.n_breath.toFixed(2)} mol = ${p.nO2.toFixed(2)} mol O₂ → ${(p.nO2*2).toFixed(2)} mol water → ${p.water.toFixed(1)} g. Feed between ${p.water.toFixed(1)} and ${(p.water*1.05).toFixed(1)} g.`]};
  if(!f.crane) return {k:'crane',g:'Hoist the fuel cask.',h:['Torque needed at the drum is m × g × r. The motor\'s torque is multiplied by the gear ratio and reduced to 90 % per stage. Speed is divided by the ratio.',`Ratio must be at least ${(p.M*GM*p.rd).toFixed(1)} ÷ (${p.Tm} × 0.81) = ${p.imin.toFixed(2)} to lift, and at most 1450 × 2π × ${p.rd} ÷ (60 × ${p.vmin.toFixed(2)}) = ${p.imax.toFixed(2)} to stay fast enough.`,`One working set: ${p.combo[0]}T → ${p.combo[1]}T, then ${p.combo[2]}T → ${p.combo[3]}T, ratio ${p.combo[4].toFixed(2)}.`]};
  if(!f.brake) return {k:'brake',g:'Set the holding brake.',h:['The lever multiplies your 150 N by its mechanical advantage, but your hand must move further than the pin by the same factor.',`You need advantage of at least ${fk(p.Fb)} ÷ 150 = ${p.maLo.toFixed(2)}, and at most 280 ÷ 20 = 14. Advantage = (1 − a) ÷ a, where a is the pivot distance from the pin.`,`Put the pivot at ${p.holes.map(k=>(k*.025).toFixed(3)+' m').join(' or ')} from the band pin.`]};
  return {k:'done',g:'Phase 3 complete.',h:[]};
}
