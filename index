/* ============================== PARAMETERS (seeded per playthrough) ============================== */
const GM=3.71;
function mulberry(a){ return ()=>{ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }
const TEETH=[12,15,18,20,24,30,36,45,48,60,72];
const CYL=[{d:25,r:21},{d:32,r:21},{d:40,r:16},{d:50,r:16},{d:63,r:12},{d:80,r:10}];
let PRC=null;
function P(){
  if(PRC&&PRC.seed===S.seed) return PRC;
  const r=mulberry(S.seed); const pick=a=>a[Math.floor(r()*a.length)]; const ri=(a,b,st=1)=>a+st*Math.floor(r()*((b-a)/st+1));
  const o={seed:S.seed};
  for(;;){ const ns=pick([6,7,8]), C=pick([4,5,6]), W=pick([120,140,160,180,200]), T=pick([3,4,5]); const V=+(3.7*ns).toFixed(1), ah=W*T/(V*.8), np=Math.ceil(ah/C-1e-9);
    if(ns*np>12&&ns*np<=28&&np>=2&&(ns*(np-1)>12||true)){ Object.assign(o,{ns,C,W,T,V,ah,np}); break; } }
  o.m=ri(4200,5200,50); o.mu=+(ri(30,40)/100).toFixed(2); o.seal=ri(800,1500,50); o.Freq=o.mu*o.m*GM+o.seal; o.Fmax=Math.round(o.Freq*1.8/100)*100;
  o.Q=ri(60,110,5); o.Tc=ri(18,28); o.Tmax=70; o.cp=3.4; o.rho=1.06; o.disp=0.035; o.mdot=o.Q/(o.cp*(o.Tmax-o.Tc)); o.Lmin=o.mdot/o.rho*60; o.rpmReq=o.Lmin/o.disp;
  o.H=ri(5,8); o.Vc=ri(20,32)/10; o.n_fill=21000*o.Vc/(8.314*293.15); o.kgBreath=.84*o.H/24*1.5; o.n_breath=o.kgBreath*1000/31.998; o.nO2=o.n_fill+o.n_breath; o.water=o.nO2*2*18.015;
  for(;;){ const M=ri(600,1000,50), rd=pick([.08,.1,.12]), Tm=pick([14,16,18,20]); const imin=M*GM*rd/(Tm*.81); const vmin=Math.floor(1450*2*Math.PI*rd/(60*1.3*imin)*100)/100; const imax=1450*2*Math.PI*rd/(60*vmin);
    const combos=[]; TEETH.forEach(a1=>TEETH.forEach(a2=>TEETH.forEach(b1=>TEETH.forEach(b2=>{ const i=(a2/a1)*(b2/b1); if(a2>a1&&b2>b1&&i>=imin&&i<=imax) combos.push([a1,a2,b1,b2,i]); }))));
    if(combos.length>=1&&vmin>=.05&&imin<34){ Object.assign(o,{M,rd,Tm,imin,imax,vmin,combo:combos[0]}); break; } }
  for(;;){ const Fb=ri(1100,1900,50); const lo=Fb/150, hi=280/20; const holes=[]; for(let k=1;k<=20;k++){ const a=k*.025, ma=(1-a)/a; if(ma>=lo&&ma<=hi) holes.push(k); } if(holes.length===1||holes.length===2){ o.Fb=Fb; o.maLo=lo; o.holes=holes; break; } }
  const cy=CYL.find(c=>{ const A=Math.PI*(c.d/2000)**2; const p=o.Freq/A/1e6; return p<=Math.min(14,c.r)&&Math.ceil(p*10)/10*1e6*A<=o.Fmax; }); o.cylAns=cy; o.pAns=Math.ceil(o.Freq/(Math.PI*(cy.d/2000)**2)/1e5)/10;
  PRC=o; return o;
}
