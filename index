$('#bSound').onclick=()=>{ audioInit(); setSound(!A.on); };
function showWin(){
  $('#winText').textContent=`The reactor is stable, ${(S.h2mol||0).toFixed(1)} mol of hydrogen is banked, and the fuel cask hangs over the propellant bay hatch. HALE: "Phase 3 complete. Next: propellant, structure, and the launch itself."`;
  $('#winStats').innerHTML=`<span class="stat"><b>${fmtT(S.t)}</b>time</span><span class="stat"><b>${S.hints}</b>hints</span><span class="stat"><b>${S.mistakes}</b>failed attempts</span>`;
  $('#win').classList.add('on');
}
$('#bAgain').onclick=()=>{ wipe(); location.reload(); };
$('#bStay').onclick=()=>$('#win').classList.remove('on');

/* ============================== INIT ============================== */
function grain(){ const c=$('#grain'); c.width=320; c.height=180; const x=c.getContext('2d'); const d=x.createImageData(320,180); for(let i=0;i<d.data.length;i+=4){ const v=Math.random()*255; d.data[i]=d.data[i+1]=d.data[i+2]=v; d.data[i+3]=255; } x.putImageData(d,0,0); c.style.width='100%'; c.style.height='100%'; }
function start(){
  audioInit(); $('#intro').classList.remove('on'); S.started=true; S.sel=null; if(!S.seed) S.seed=(Math.random()*2**31)|0; P();
  renderInv(); $('#hintN').textContent=S.hints;
  const el=L('L0'); cur='L0'; L('L1').classList.add('hidden'); mount(el,S.scene); el.classList.remove('hidden');
  $('#back').style.display=scenes[S.scene].parent?'block':'none';
  if(S.t<5) setTimeout(()=>say('Emergency lighting. Somewhere, a fan ticks over and stops. The station is running on nothing.',4600),900);
  save(); if(S.f.won) showWin();
}
setInterval(()=>{ if(!S.started||S.f.won||document.hidden) return; S.t++; $('#timer').textContent=fmtT(S.t); if(S.t%10===0) save(); },1000);
grain();
if(location.hash==='#qa') window.__qa={P:()=>P(),S:()=>S};
const saved=load();
if(saved && saved.started){ $('#bContinue').style.display=''; $('#bContinue').onclick=()=>{ S=saved; S.sel=null; start(); }; }
$('#bBegin').onclick=()=>{ S=fresh(); start(); };
})();
</script>
</body>
</html>
