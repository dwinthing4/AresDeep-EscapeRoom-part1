function sandbox(box,id,fn){ const root=box.querySelector('#'+id); if(!root) return; const run=()=>{ const v={}; root.querySelectorAll('input').forEach(i=>v[i.name]=+i.value); root.querySelectorAll('[data-show]').forEach(s=>{ const n=s.dataset.show; s.textContent=v[n]; }); root.querySelector('.out').innerHTML=fn(v); }; root.querySelectorAll('input').forEach(i=>i.oninput=run); run(); }
const rng=(name,min,max,step,val,label)=>`<label style="display:block;margin:.35rem 0">${label}: <b data-show="${name}"></b><br><input type="range" name="${name}" min="${min}" max="${max}" step="${step}" value="${val}" style="width:100%"></label>`;
const MAN=[
 {t:'Electrical',h:`<h3>Batteries: series, parallel, usable energy</h3><p>Cells wired <b>in series</b> add their voltages. Strings wired <b>in parallel</b> add their capacities (amp-hours, Ah). A pack of S cells in series and P strings in parallel has <span style="font-family:var(--tape)">V = S × V<sub>cell</sub></span> and <span style="font-family:var(--tape)">Ah = P × Ah<sub>cell</sub></span>.</p><p>Energy = V × Ah (watt-hours). Lithium cells are only drained to a set <b>depth of discharge</b> to protect them, so usable energy = V × Ah × DoD. Runtime = usable energy ÷ load power.</p><p><i>Worked example:</i> a 12.0 V, 90 W load needs 6 h with 80 % DoD, from 3.0 V, 10 Ah cells. Series: 12.0 ÷ 3.0 = 4 cells. Energy needed 90 × 6 = 540 Wh, so pack Wh before DoD = 540 ÷ 0.8 = 675 Wh. Ah = 675 ÷ 12 = 56.25 Ah, so 6 parallel strings (60 Ah). Total 24 cells.</p><div id="sbE" class="paper" style="margin-top:.6rem">${rng('s',1,8,1,4,'Series cells')}${rng('p',1,6,1,2,'Parallel strings')}${rng('w',50,250,10,100,'Load (W)')}<div class="out"></div></div>`,sb:['sbE',v=>`Pack ${(3.7*v.s).toFixed(1)} V, ${v.p*5} Ah (5 Ah cells). Usable ${(3.7*v.s*v.p*5*.8).toFixed(0)} Wh. Runtime at ${v.w} W: <b>${(3.7*v.s*v.p*5*.8/v.w).toFixed(2)} h</b>.`]},
 {t:'Digital logic',h:`<h3>Truth tables, K-maps, NAND</h3><p>A <b>Karnaugh map</b> lays out a truth table so that neighbouring cells differ by one input. Columns and rows go 00, 01, 11, 10 (Gray code), and the edges wrap round.</p><p>Circle groups of 1s in sizes 1, 2, 4 or 8, as big as possible. Each group becomes one AND term made of the inputs that stay constant inside it. OR the terms together.</p><p><i>Worked example:</i> Y is 1 when (P and Q) or R, but never when S. In the map, the R=1 columns form a group of 8 → R. The P=1,Q=1 row forms a group → P·Q. S=1 cells are 0, so Y = ¬S·(P·Q + R).</p><p><b>NAND is universal:</b> NOT x = NAND(x, x). x AND y = NOT(NAND(x, y)). x OR y = NAND(NOT x, NOT y). So any SOP expression can be built from NANDs alone.</p><p>Floating TTL inputs read as 1, so a NAND with one input left open acts as an inverter.</p>`},
 {t:'Fluid power',h:`<h3>Hydraulic force and friction</h3><p><b>Pascal's law:</b> pressure in a confined fluid acts equally everywhere. A cylinder's force is <span style="font-family:var(--tape)">F = p × A</span>, with A = π d² ÷ 4.</p><p>To slide a heavy object you must beat static friction: <span style="font-family:var(--tape)">F = μ<sub>s</sub> × m × g</span>, plus any other drag. <b>On Mars, g = 3.71 m/s²</b>, not 9.81.</p><p>Units: 1 MPa = 1,000,000 N/m². A 50 mm bore is 0.050 m.</p><p><i>Worked example:</i> a 2,000 kg cart on Earth, μ<sub>s</sub> 0.25, plus 500 N drag: F = 0.25 × 2,000 × 9.81 + 500 = 5,405 N. With a 32 mm bore (A = 0.000804 m²) you need 5,405 ÷ 0.000804 = 6.72 MPa. Never exceed the cylinder's rated pressure, or the push the structure can take.</p><div id="sbF" class="paper" style="margin-top:.6rem">${rng('d',20,100,1,40,'Bore (mm)')}${rng('p',1,20,.5,8,'Pressure (MPa)')}<div class="out"></div></div>`,sb:['sbF',v=>`Area ${(Math.PI*(v.d/2000)**2*1e6).toFixed(0)} mm². Force <b>${fk(v.p*1e6*Math.PI*(v.d/2000)**2)} N</b>.`]},
 {t:'Heat transfer',h:`<h3>Coolant flow</h3><p>Heat carried by a flowing liquid: <span style="font-family:var(--tape)">Q = ṁ × c × ΔT</span>. Q in kW, ṁ in kg/s, c in kJ/(kg·K), ΔT in K (a 1 °C difference equals 1 K).</p><p>Rearranged: ṁ = Q ÷ (c × ΔT). Convert mass flow to volume with density: L/s = ṁ ÷ ρ. Multiply by 60 for L/min. A positive-displacement pump moves a fixed volume per revolution, so rpm = (L/min) ÷ (L/rev).</p><p><i>Worked example:</i> 50 kW, coolant enters at 30 °C and may leave at 80 °C (ΔT 50 K), c = 4.0 kJ/(kg·K), ρ = 1.0 kg/L. ṁ = 50 ÷ (4.0 × 50) = 0.25 kg/s = 15 L/min. With 0.05 L/rev, the pump needs 300 rpm.</p><p>Too little flow overheats the core. Far too much can thermally shock it.</p>`},
 {t:'Chemistry',h:`<h3>Moles, gases and electrolysis</h3><p>A <b>mole</b> is a fixed number of particles. Molar mass converts grams to moles: H₂O = 2 × 1.008 + 15.999 = 18.015 g/mol; O₂ = 31.998 g/mol.</p><p>Electrolysis: <span style="font-family:var(--tape)">2 H₂O → 2 H₂ + O₂</span>. Two moles of water give one mole of O₂ and two of H₂.</p><p><b>Ideal gas law:</b> <span style="font-family:var(--tape)">n = pV ÷ (RT)</span>, with p in Pa, V in m³, T in kelvin (°C + 273.15), R = 8.314.</p><p><i>Worked example:</i> fill 1.0 m³ with O₂ at 20 kPa and 20 °C: n = 20,000 × 1.0 ÷ (8.314 × 293.15) = 8.21 mol. Two people for 12 h at 0.84 kg/day each = 0.84 kg O₂ = 26.25 mol. Total 34.46 mol O₂ needs 68.92 mol water = 1,241.6 g.</p><p>Flight rules may demand a reserve: multiply the consumption part, not the cabin fill, by the reserve factor.</p>`},
 {t:'Mechanical',h:`<h3>Gear trains and levers</h3><p>A gear stage's ratio is driven teeth ÷ driver teeth. Stages multiply. A ratio of i <b>multiplies torque by i</b> and <b>divides speed by i</b>, minus friction: each stage here passes 90 % of the torque.</p><p>Hoist torque needed = m × g × r (drum radius). Rope speed = (rpm ÷ i) × 2πr ÷ 60.</p><p><i>Worked example:</i> lift 500 kg on Mars with a 0.10 m drum: 500 × 3.71 × 0.10 = 185.5 N·m. A 10 N·m motor through two 90 % stages needs i ≥ 185.5 ÷ (10 × 0.81) = 22.9. Gears 12→48 then 15→90 would give 4 × 6 = 24.</p><p><b>Levers:</b> force × distance balances on each side of the pivot. Mechanical advantage = long arm ÷ short arm. More advantage means more hand travel: the pin moves less than your hand by the same factor.</p><div id="sbG" class="paper" style="margin-top:.6rem">${rng('a',12,72,1,15,'Stage 1 driver teeth')}${rng('b',12,72,1,45,'Stage 1 driven teeth')}<div class="out"></div></div>`,sb:['sbG',v=>`Stage ratio <b>${(v.b/v.a).toFixed(2)}</b>. A 10 N·m, 1,450 rpm motor gives ${(10*v.b/v.a*.9).toFixed(1)} N·m at ${(1450*v.a/v.b).toFixed(0)} rpm.`]},
];
function openManual(start=0){
  let p=start; const draw=(box,turn)=>{ const pg=box.querySelector('.page'); pg.innerHTML=MAN[p].h+`<span class="pno">${p+1} / ${MAN.length}</span>`; if(turn){ pg.classList.remove('turn'); void pg.offsetWidth; pg.classList.add('turn'); } box.querySelectorAll('#mnTabs button').forEach((b,i)=>b.classList.toggle('ghost',i!==p)); if(MAN[p].sb) sandbox(box,MAN[p].sb[0],MAN[p].sb[1]); };
  modal('HALE engineering manual',`<div id="mnTabs" class="mbtns" style="margin:0 0 .7rem">${MAN.map((m,i)=>`<button class="mbtn ghost" data-i="${i}" style="padding:.25rem .6rem;font-size:.9rem">${m.t}</button>`).join('')}</div><div class="book"><div class="page" style="width:min(44rem,88vw)"></div></div>`,box=>{ draw(box); box.querySelectorAll('#mnTabs button').forEach(b=>b.onclick=()=>{ p=+b.dataset.i; sfx.page(); draw(box,1); }); });
}

