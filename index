<div id="app">
  <header id="hud">
    <h1>Ares Deep · Part 1</h1>
    <span class="spacer"></span>
    <span id="timer" title="Time elapsed">00:00</span>
    <button class="hbtn" id="bHint">Hints <span class="n" id="hintN">0</span></button>
    <button class="hbtn" id="bJournal">Journal</button>
    <button class="hbtn" id="bManual">HALE manual</button>
    <button class="hbtn" id="bSound" aria-pressed="true">Sound on</button>
    <button class="hbtn" id="bMenu">Menu</button>
  </header>
  <main id="stage-wrap">
    <div id="stage">
      <div class="layer" id="L0"></div>
      <div class="layer hidden" id="L1"></div>
      <canvas id="grain"></canvas>
      <div id="vignette"></div>
      <div id="flash"></div>
      <button id="back">&#8592; Step back</button>
      <div id="caption"></div>
      <div id="toast"></div>
    </div>
  </main>
  <footer id="inv"><span class="lbl">Satchel</span><div id="slots" style="display:flex;gap:.5rem"></div><span id="invhelp">Click an item to select it, then click where to use it. Double-click to examine.</span></footer>
</div>

<div id="modal" role="dialog" aria-modal="true"><div id="mbox"><button id="mclose" aria-label="Close">&times;</button><div id="mcontent"></div></div></div>

<div class="overlay on" id="intro">
  <div class="ovin" style="position:relative">
    <h2 class="t1">Ares Deep</h2>
    <div class="t2">Jezero Crater, Mars · Sol 412, 2091 · Part 1 of 2</div>
    <p>A dust storm cut the station's power. The crew evacuated to the orbiter while you were sedated in the medbay after an EVA accident. They couldn't wait. They'll come round again, and you have to be ready to launch.</p>
    <p>The station's AI, HALE, still has every engineering manual on file but nothing to run on. Everything that needs doing, you'll have to work out yourself: batteries, logic, hydraulics, heat, chemistry, gears.</p>
    <p>Every number in this station is different each time you play. Read the data plates. Use the manual. Show your working.</p>
    <div class="mbtns"><button class="mbtn" id="bBegin">Begin</button><button class="mbtn ghost" id="bContinue" style="display:none">Continue saved game</button></div>
  </div>
</div>
<div class="overlay" id="win">
  <div class="ovin">
    <h2 class="t1">Phase 3 complete</h2>
    <div class="t2">Power, access, heat, oxygen and lift are done</div>
    <p id="winText"></p>
    <div id="winStats" style="margin-top:1.2rem"></div>
    <p style="opacity:.8">Part 2 continues in the propellant bay: combustion chemistry, fuel transfer, structures and the launch.</p>
    <div class="mbtns"><button class="mbtn" id="bAgain">New game, new numbers</button><button class="mbtn ghost" id="bStay">Stay on the station</button></div>
  </div>
</div>

<script>
(()=>{
"use strict";
const $=s=>document.querySelector(s);
const SAVE='ares-deep-1-v1';
const VW=1600, VH=900;

/* ============================== STATE ============================== */
const fresh=()=>({scene:'hab',t:0,hints:0,tier:{},inv:[],taken:{},f:{},journal:[],mistakes:0,origins:{},sel:null,seed:0});
let S=fresh();
let saveT=null;
function save(){ clearTimeout(saveT); saveT=setTimeout(()=>{ try{ localStorage.setItem(SAVE,JSON.stringify(S)); }catch(e){} },150); }
function load(){ try{ const r=localStorage.getItem(SAVE); if(r){ const o=JSON.parse(r); if(o&&o.t!==undefined) return Object.assign(fresh(),o); } }catch(e){} return null; }
function wipe(){ try{ localStorage.removeItem(SAVE); }catch(e){} }

/* ============================== AUDIO ============================== */
const A={ctx:null,on:true};
function audioInit(){
  if(A.ctx) return;
  try{ A.ctx=new (window.AudioContext||window.webkitAudioContext)(); }catch(e){ return; }
  const c=A.ctx;
  A.master=c.createGain(); A.master.gain.value=A.on?0.85:0; A.master.connect(c.destination);
  const len=c.sampleRate*2, b=c.createBuffer(1,len,c.sampleRate), d=b.getChannelData(0);
  for(let i=0;i<len;i++) d[i]=Math.random()*2-1;
  A.noise=b;
  // rain bed
  const r=c.createBufferSource(); r.buffer=b; r.loop=true;
  const rf=c.createBiquadFilter(); rf.type='bandpass'; rf.frequency.value=2600; rf.Q.value=.35;
  const rg=c.createGain(); rg.gain.value=.045; r.connect(rf).connect(rg).connect(A.master); r.start();
  // wind with slow swell
  const w=c.createBufferSource(); w.buffer=b; w.loop=true; w.playbackRate.value=.5;
  const wf=c.createBiquadFilter(); wf.type='lowpass'; wf.frequency.value=380;
  const wg=c.createGain(); wg.gain.value=.07;
  const lfo=c.createOscillator(); lfo.frequency.value=.07; const lg=c.createGain(); lg.gain.value=.05; lfo.connect(lg).connect(wg.gain); lfo.start();
  w.connect(wf).connect(wg).connect(A.master); w.start();
  // morse tone
  const o=c.createOscillator(); o.type='sine'; o.frequency.value=640;
  const og=c.createGain(); og.gain.value=0; o.connect(og).connect(A.master); o.start();
  A.toneG=og; A.toneO=o;
}
function nz({dur=.15,freq=1200,q=1,type='bandpass',gain=.4,attack=.004,delay=0}={}){
  if(!A.ctx) return; const c=A.ctx, t=c.currentTime+delay;
  const s=c.createBufferSource(); s.buffer=A.noise; s.playbackRate.value=.6+Math.random()*.8;
  const f=c.createBiquadFilter(); f.type=type; f.frequency.value=freq; f.Q.value=q;
  const g=c.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(gain,t+attack); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  s.connect(f).connect(g).connect(A.master); s.start(t,Math.random()); s.stop(t+dur+.05);
}
function tn(freq,dur,type='sine',gain=.15,slide,delay=0){
  if(!A.ctx) return; const c=A.ctx, t=c.currentTime+delay;
  const o=c.createOscillator(); o.type=type; o.frequency.setValueAtTime(freq,t); if(slide) o.frequency.exponentialRampToValueAtTime(slide,t+dur);
  const g=c.createGain(); g.gain.setValueAtTime(0.0001,t); g.gain.linearRampToValueAtTime(gain,t+.008); g.gain.exponentialRampToValueAtTime(0.0001,t+dur);
  o.connect(g).connect(A.master); o.start(t); o.stop(t+dur+.05);
}
const sfx={
  click(){ nz({dur:.05,freq:3200,q:2,gain:.35}); tn(2200,.03,'square',.02); },
  tick(){ nz({dur:.03,freq:4200,q:5,gain:.22}); },
  clunk(){ nz({dur:.3,freq:260,q:1,type:'lowpass',gain:.8}); tn(95,.3,'sine',.35,48); },
  slide(){ nz({dur:.55,freq:650,q:.8,gain:.28,attack:.09}); },
  creak(){ tn(150,.9,'sawtooth',.045,85); nz({dur:.8,freq:420,q:4,gain:.14,attack:.15}); },
  unlock(){ sfx.click(); nz({dur:.14,freq:2300,q:3,gain:.35,delay:.12}); tn(1320,.3,'triangle',.07,null,.12); },
  rattle(){ for(let i=0;i<5;i++) nz({dur:.05,freq:1700+i*230,q:4,gain:.28,delay:i*.055}); },
  buzz(){ tn(105,.32,'square',.06); },
  pick(){ tn(660,.14,'triangle',.08,990); },
  page(){ nz({dur:.32,freq:4200,q:.5,gain:.16,attack:.06}); },
  match(){ nz({dur:.25,freq:3400,q:.3,gain:.4,attack:.005}); nz({dur:1.2,freq:700,q:.5,gain:.09,attack:.25,delay:.15}); },
  thunder(){ nz({dur:3.6,freq:130,q:.4,type:'lowpass',gain:1,attack:.08}); nz({dur:1.4,freq:300,q:.6,type:'lowpass',gain:.5,attack:.02,delay:.2}); },
  chime(){ [0,1].forEach(i=>{ tn(523,2.2,'sine',.12,null,i*.7); tn(1046,1.6,'sine',.04,null,i*.7); tn(1568,1.1,'sine',.02,null,i*.7); }); },
  success(){ [523,659,784,1046].forEach((f,i)=>tn(f,1,'triangle',.09,null,i*.11)); },
  whoosh(){ nz({dur:.55,freq:900,q:.6,gain:.13,attack:.2}); },
  gears(){ for(let i=0;i<14;i++) nz({dur:.04,freq:2600+(i%3)*400,q:6,gain:.2,delay:i*.09}); sfx.clunk(); },
  splash(){ nz({dur:.6,freq:1600,q:.4,gain:.15,attack:.02}); },
  hum(on){ if(!A.ctx) return; },
};
function toneOn(f=640){ if(!A.ctx) return; A.toneO.frequency.setValueAtTime(f,A.ctx.currentTime); A.toneG.gain.setTargetAtTime(.16,A.ctx.currentTime,.004); }
function toneOff(){ if(!A.ctx) return; A.toneG.gain.setTargetAtTime(0,A.ctx.currentTime,.004); }
function setSound(on){ A.on=on; if(A.master) A.master.gain.setTargetAtTime(on?.85:0,A.ctx.currentTime,.05); $('#bSound').textContent=on?'Sound on':'Sound off'; $('#bSound').setAttribute('aria-pressed',on); }

/* ============================== UI HELPERS ============================== */
let toastT=null;
function say(msg,ms=3400){ const t=$('#toast'); t.innerHTML=msg; t.classList.add('on'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('on'),ms); }
function cap(txt){ const c=$('#caption'); if(txt){ c.textContent=txt; c.classList.add('on'); } else c.classList.remove('on'); }
function note(txt){ if(!S.journal.includes(txt)){ S.journal.push(txt); save(); const b=$('#bJournal'); b.style.borderColor='var(--amber)'; setTimeout(()=>b.style.borderColor='',2500); } }
function fmtT(s){ s=Math.floor(s); const h=Math.floor(s/3600), m=Math.floor(s%3600/60), x=s%60; return (h?h+':':'')+String(m).padStart(2,'0')+':'+String(x).padStart(2,'0'); }
const rnd=(a,b)=>a+Math.random()*(b-a);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ============================== ITEMS ============================== */
const ITEMS={};
function give(id){
  if(S.inv.includes(id)) return;
  S.inv.push(id); S.taken[id]=true; sfx.pick(); renderInv(id); say(`Added to satchel: <b>${ITEMS[id].name}</b>`); save();
}
function renderInv(newId){
  const box=$('#slots'); box.innerHTML='';
  const n=Math.max(7,S.inv.length);
  for(let i=0;i<n;i++){
    const id=S.inv[i]; const b=document.createElement('button');
    b.className='slot'+(id?'':' empty')+(id&&S.sel===id?' sel':'')+(id&&id===newId?' new':'');
    if(id){ b.innerHTML=ITEMS[id].icon; b.title=ITEMS[id].name; b.setAttribute('aria-label',ITEMS[id].name);
      b.onclick=()=>{ audioInit(); if(S.sel===id){ deselect(); examine(id); } else { S.sel=id; renderInv(); applySel(); say(`Holding the <b>${ITEMS[id].name}</b>. Click something to use it on, or click it again to examine.`,2800); } };
      b.ondblclick=()=>{ deselect(); examine(id); };
    } else { b.disabled=true; b.setAttribute('aria-hidden','true'); }
    box.appendChild(b);
  }
}
function deselect(){ S.sel=null; renderInv(); applySel(); }
function applySel(){ document.querySelectorAll('.layer').forEach(l=>{ l.classList.toggle('selmode',!!S.sel); l.querySelectorAll('[data-use]').forEach(h=>h.classList.toggle('usable',!!S.sel && h.dataset.use.split(' ').includes(S.sel))); }); }

/* ============================== MODAL ============================== */
let onModalClose=null;
function modal(title,html,mount,onClose){
  $('#mcontent').innerHTML=(title?`<h2>${title}</h2>`:'')+html;
  $('#modal').classList.add('on'); onModalClose=onClose||null;
  if(mount) mount($('#mcontent'));
  setTimeout(()=>$('#mclose').focus(),30);
}
function closeModal(){ $('#modal').classList.remove('on'); $('#mcontent').innerHTML=''; if(onModalClose){ const f=onModalClose; onModalClose=null; f(); } }
$('#mclose').onclick=closeModal;
$('#modal').addEventListener('click',e=>{ if(e.target.id==='modal') closeModal(); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape'){ if($('#modal').classList.contains('on')) closeModal(); else if(S.sel) deselect(); else if(scenes[S.scene]&&scenes[S.scene].parent) goBack(); } });

/* ============================== SCENE ENGINE ============================== */
const scenes={};
let cur='L0', busy=false;
const L=id=>document.getElementById(id);
function chain(id){ const a=[]; let s=id; while(s){ a.push(s); s=scenes[s]&&scenes[s].parent; } return a; }
function mount(el,id){
  const sc=scenes[id];
  el.innerHTML=`<svg viewBox="0 0 ${VW} ${VH}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${esc(sc.title)}">${sc.render()}</svg>`;
  el.dataset.scene=id;
  el.querySelectorAll('[data-go],[data-act]').forEach(h=>{ h.classList.add('hot'); h.setAttribute('tabindex','0'); h.setAttribute('role','button'); if(h.dataset.cap) h.setAttribute('aria-label',h.dataset.cap);
    if(!h.querySelector('.hl')){ try{ const bb=h.getBBox(); const r=document.createElementNS('http://www.w3.org/2000/svg','rect'); r.setAttribute('class','hl'); r.setAttribute('x',bb.x-6); r.setAttribute('y',bb.y-6); r.setAttribute('width',bb.width+12); r.setAttribute('height',bb.height+12); r.setAttribute('rx',8); h.appendChild(r);}catch(e){} } });
  if(sc.mount) sc.mount(el);
  if(sc.update) sc.update(el);
  updateShips(el); applySel();
}
function stageOriginOf(h,el){
  try{ const bb=h.getBBox(); const svg=el.querySelector('svg'); return {x:(bb.x+bb.width/2)/VW*100,y:(bb.y+bb.height/2)/VH*100}; }catch(e){ return {x:50,y:50}; }
}
function go(id,origin){
  if(busy||id===S.scene||!scenes[id]) return;
  busy=true; cap(null);
  const fromId=S.scene, from=L(cur), nextL=cur==='L0'?'L1':'L0', to=L(nextL);
  const deeper=!chain(fromId).includes(id);
  if(scenes[fromId].leave) scenes[fromId].leave();
  if(deeper){ S.origins[id]=origin||S.origins[id]||{x:50,y:50}; }
  const o=deeper?S.origins[id]:(S.origins[fromId]||{x:50,y:50});
  S.scene=id; save();
  mount(to,id); to.classList.remove('hidden');
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const D=reduce?250:700;
  sfx.whoosh();
  let a1,a2;
  if(deeper){
    from.style.transformOrigin=`${o.x}% ${o.y}%`;
    a1=from.animate([{transform:'scale(1)',opacity:1},{transform:reduce?'scale(1)':'scale(2.6)',opacity:0}],{duration:D,easing:'cubic-bezier(.55,0,.8,.3)',fill:'forwards'});
    to.style.transformOrigin=`${o.x}% ${o.y}%`;
    a2=to.animate([{transform:reduce?'scale(1)':'scale(.55)',opacity:0},{transform:'scale(1)',opacity:1}],{duration:D,delay:D*.38,easing:'cubic-bezier(.2,.7,.2,1)',fill:'backwards'});
  } else {
    from.style.transformOrigin=`${o.x}% ${o.y}%`;
    a1=from.animate([{transform:'scale(1)',opacity:1},{transform:reduce?'scale(1)':'scale(.5)',opacity:0}],{duration:D*.8,easing:'cubic-bezier(.5,0,.8,.4)',fill:'forwards'});
    to.style.transformOrigin=`${o.x}% ${o.y}%`;
    a2=to.animate([{transform:reduce?'scale(1)':'scale(2.4)',opacity:0},{transform:'scale(1)',opacity:1}],{duration:D,delay:D*.2,easing:'cubic-bezier(.2,.7,.2,1)',fill:'backwards'});
  }
  to.style.zIndex=2; from.style.zIndex=1;
  let done=false;
  const finish=()=>{ if(done) return; done=true; try{a1.cancel();}catch(e){} from.classList.add('hidden'); from.innerHTML=''; from.style.zIndex=''; cur=nextL; busy=false; $('#back').style.display=scenes[id].parent?'block':'none'; if(scenes[id].enter) scenes[id].enter(to); };
  a2.onfinish=finish; setTimeout(finish,D*1.4+120);
}
function goBack(){ const p=scenes[S.scene].parent; if(p) go(p); }
$('#back').onclick=()=>{ audioInit(); goBack(); };
function curEl(){ return L(cur); }
function refresh(){ const sc=scenes[S.scene]; if(sc&&sc.update) sc.update(curEl()); applySel(); save(); }

// delegated interaction
['L0','L1'].forEach(lid=>{
  const el=L(lid);
  el.addEventListener('click',e=>{
    audioInit();
    if(busy||el.dataset.scene!==S.scene) return;
    const h=e.target.closest('[data-go],[data-act]'); if(!h) return;
    const sc=scenes[S.scene];
    if(h.dataset.drag==='1' && el._dragged){ el._dragged=false; return; }
    if(S.sel){
      const uses=(h.dataset.use||'').split(' ');
      if(uses.includes(S.sel)){ const it=S.sel; deselect(); sc.use(it,h.dataset.act||h.dataset.go,h,el); return; }
      if(h.dataset.act){ say(`The ${ITEMS[S.sel].name.toLowerCase()} is no use there.`); deselect(); return; }
    }
    if(h.dataset.go){ if(h.dataset.lock && !sc.canGo(h.dataset.go,h)) return; go(h.dataset.go,stageOriginOf(h,el)); return; }
    if(h.dataset.act && sc.act) sc.act(h.dataset.act,h,el,e);
  });
  el.addEventListener('keydown',e=>{ if(S.scene==='console'&&e.key==='Enter') return; if((e.key==='Enter'||e.key===' ') && e.target.closest('[data-go],[data-act]')){ e.preventDefault(); e.target.closest('[data-go],[data-act]').dispatchEvent(new MouseEvent('click',{bubbles:true})); } });
  el.addEventListener('mouseover',e=>{ const h=e.target.closest('[data-cap]'); if(h&&!busy) cap(h.dataset.cap); });
  el.addEventListener('mouseout',e=>{ const h=e.target.closest('[data-cap]'); if(h&&!h.contains(e.relatedTarget)) cap(null); });
});

/* ============================== SHARED ART ============================== */
function rainDrops(x,y,w,h,n,op=.45){
  let s=`<g opacity="${op}" stroke="#a9c6d6" stroke-width="1.4" stroke-linecap="round">`;
  for(let i=0;i<n;i++){ const px=x+Math.random()*(w+40), py=y+Math.random()*h*.8, l=rnd(10,22);
    s+=`<line class="drop" x1="${px.toFixed(0)}" y1="${py.toFixed(0)}" x2="${(px-3).toFixed(0)}" y2="${(py+l).toFixed(0)}" style="animation-delay:${(-Math.random()).toFixed(2)}s;animation-duration:${rnd(.45,.7).toFixed(2)}s"/>`; }
  return s+'</g>';
}
function shipG(){
  return `<g class="ship-inner">
    <path d="M-60 0 L60 0 L48 14 L-50 14Z" fill="#05090c"/>
    <path d="M-20 0 V-70 M18 0 V-60" stroke="#05090c" stroke-width="3"/>
    <path d="M-34 -6 H30 V-16 H-34Z" fill="#070c10"/>
    <circle cx="-20" cy="-72" r="16" fill="url(#gLampGlow)" class="pulse"/><circle cx="-20" cy="-72" r="2.6" fill="#fff6dc"/>
    <circle cx="-40" cy="-6" r="12" fill="#ff5a3c" opacity=".25"/><circle cx="-40" cy="-6" r="2.4" fill="#ff7a5c"/>
    <circle cx="40" cy="-6" r="2" fill="#7dff9a" opacity=".55"/>
    <rect x="-10" y="-12" width="5" height="3" fill="#ffd27a" opacity=".7"/><rect x="2" y="-12" width="5" height="3" fill="#ffd27a" opacity=".5"/>
  </g>`;
}
function beamWedges(cx,cy,len,spread){
  const d=`M${cx} ${cy} L${cx+len} ${cy-spread} L${cx+len} ${cy+spread}Z`;
  return `<path class="sweep" d="${d}" fill="url(#gBeam)"/><path class="sweep" style="animation-delay:-3s" d="${d}" fill="url(#gBeam)" transform="translate(${2*cx} 0) scale(-1 1)"/>`;
}
// Sea view inside an arbitrary clip shape. box = sea area; hz = horizon y
function seaView(id,x,y,w,h,clipD,opts={}){
  const hz=y+h*(opts.hz||.55);
  let clouds=''; for(let i=0;i<7;i++){ clouds+=`<ellipse cx="${x+rnd(0,w)}" cy="${y+rnd(0,(hz-y)*.7)}" rx="${rnd(w*.12,w*.3)}" ry="${rnd(18,46)}" fill="#33495a" opacity="${rnd(.25,.5).toFixed(2)}" filter="url(#soft)"/>`; }
  let waves=''; for(let i=0;i<9;i++){ const yy=hz+ (y+h-hz)*(i/9)+6; waves+=`<path class="wave" style="animation-delay:${-i*.7}s;animation-duration:${4+i%3}s" d="M${x-60} ${yy} q ${w/16} -${4+i} ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0 t ${w/8} 0" stroke="#5f8796" stroke-width="${1+i*.25}" fill="none" opacity="${.15+i*.04}"/>`; }
  const rx=x+w*.18, ry=hz+(y+h-hz)*.45;
  const rocks=`<g><path d="M${rx-w*.14} ${ry+30} L${rx-w*.09} ${ry-12} L${rx-w*.05} ${ry+4} L${rx} ${ry-26} L${rx+w*.05} ${ry} L${rx+w*.1} ${ry-8} L${rx+w*.16} ${ry+30}Z" fill="#05090b"/>
    <ellipse cx="${rx}" cy="${ry+24}" rx="${w*.17}" ry="9" fill="#d9eef5" opacity=".35" class="pulse" filter="url(#soft2)"/>
    <ellipse cx="${rx+w*.06}" cy="${ry+10}" rx="${w*.05}" ry="5" fill="#e6f5fa" opacity=".4" class="pulse" style="animation-delay:-.8s" filter="url(#soft2)"/></g>`;
  const beam=(S.f.beam&&!opts.noBeam)?`<g opacity=".4" pointer-events="none">${beamWedges(x+w*.5,hz-h*.18,w*.9,h*.12)}</g>`:'';
  return `<clipPath id="cp-${id}"><path d="${clipD}"/></clipPath>
  <g clip-path="url(#cp-${id})">
    <rect x="${x}" y="${y}" width="${w}" height="${hz-y+2}" fill="url(#gSky)"/>
    ${clouds}
    <rect x="${x}" y="${hz}" width="${w}" height="${y+h-hz}" fill="url(#gSea)"/>
    ${waves}
    <g class="ship" data-box="${x},${hz},${w},${y+h-hz}" data-s="${opts.ss||1}">${shipG()}</g>
    ${rocks}
    ${beam}
    ${rainDrops(x,y,w,h,opts.drops||Math.round(w*h/9000))}
    <rect class="winflash" x="${x}" y="${y}" width="${w}" height="${h}" fill="#dfeeff" opacity="0"/>
  </g>`;
}
function shipP(){ return Math.min(1,S.t/(75*60)); }
function updateShips(root){
  (root||document).querySelectorAll('.ship').forEach(g=>{
    const [x,hz,w,h]=g.dataset.box.split(',').map(Number), ss=+g.dataset.s;
    let p=shipP(), X, Y, sc;
    if(S.f.won){ X=x+w*1.05; Y=hz+h*.08; sc=.35*ss; g.style.transition='transform 6s ease-in'; }
    else { X=x+w*(.92-.6*p); Y=hz+h*(.06+.3*p); sc=(.32+.75*p)*ss*(w/1000); }
    if(!S.f.won) sc=Math.max(sc,.12);
    g.setAttribute('transform',`translate(${X.toFixed(1)} ${Y.toFixed(1)}) scale(${sc.toFixed(3)})`);
  });
}
function lightning(){
  const el=curEl(); const f=$('#flash');
  f.classList.remove('on'); void f.offsetWidth; f.classList.add('on');
  el.querySelectorAll('.winflash').forEach(r=>{ r.animate([{opacity:0},{opacity:.6},{opacity:.05},{opacity:.45},{opacity:0}],{duration:900,easing:'ease-out'}); });
  setTimeout(()=>sfx.thunder(),rnd(500,1800));
}
function scheduleLightning(){ setTimeout(()=>{ if(S.started && !document.hidden) lightning(); scheduleLightning(); },rnd(14000,32000)); }

// brass screw
const screw=(x,y,r=6)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="url(#gBrassR)" stroke="#4a3510" stroke-width="1"/><line x1="${x-r*.6}" y1="${y}" x2="${x+r*.6}" y2="${y}" stroke="#4a3510" stroke-width="1.4"/>`;


/* ============================== ROOM 3 DEFS ============================== */
