  if(a==='s+'){ S.bs=Math.min(8,S.bs+1); } if(a==='s-'){ S.bs=Math.max(1,S.bs-1); } if(a==='p+'){ S.bp=Math.min(6,S.bp+1); } if(a==='p-'){ S.bp=Math.max(1,S.bp-1); }
  if(a.length===2){ sfx.click(); refresh(); return; }
  if(a==='contactor'){
