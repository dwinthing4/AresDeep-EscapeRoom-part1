function gearPath(cx,cy,r,n){ let d=''; const t=Math.max(3,r*.14); for(let i=0;i<n*2;i++){ const a0=i*Math.PI/n, a1=(i+1)*Math.PI/n, R=i%2?r-t:r+t*.4; const p=(a,rr)=>`${(cx+rr*Math.cos(a)).toFixed(1)} ${(cy+rr*Math.sin(a)).toFixed(1)}`; d+=(i?'L':'M')+p(a0+.04,R)+' L'+p(a1-.04,R)+' '; } return d+'Z'; }
function ledText(x,y,txt,size,col,id=''){ return `<text ${id?`id="${id}"`:''} x="${x}" y="${y}" text-anchor="middle" font-family="JetBrains Mono, Consolas, monospace" font-weight="700" font-size="${size}" fill="${col}" filter="url(#glowT)">${txt}</text>`; }
